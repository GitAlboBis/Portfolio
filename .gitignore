# dependencies
/node_modules
/.pnp
.pnp.*

# package manager: npm (see package.json scripts). Keep stray lockfiles of other
# managers out; the npm lockfile stays out of the tree until WP-10 decides.
/package-lock.json
/yarn.lock
/bun.lock

# next.js
/.next/
/out/
/build

# misc
.DS_Store
*.pem
desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# claude code — personal overrides (contains secrets, e.g. API_KEY_21ST)
.claude/settings.local.json

# visual-gate screenshots and probe output (run artefacts, not sources)
.shots/
scripts/probes/*.out.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large working video assets (hero clip source — add later via Git LFS, not raw git)
/public/video/

# docs-driven-build loop: run-time screenshot artifacts (state ledger IS committed)
/loops/docs-driven-build/artifacts/

# design-system research scratch (captured in DESIGN-SYSTEM.md)
/.wf-out/

# reference repo clones studied for the water sim (Splash / WaterBall) — not ours
/.analysis-clones/
.env*
