diff --git a/public/proto/rivista/fx-scroll.css b/public/proto/rivista/fx-scroll.css
index 47f72ef..c2fa683 100644
--- a/public/proto/rivista/fx-scroll.css
+++ b/public/proto/rivista/fx-scroll.css
@@ -1014,13 +1014,50 @@ html.stage-on .st-still, html.stage-on [data-stage-poster] { display: none; }
 /* 13c · Consulting's foot: a ghost link on to Obla, the next night page */
 .st-on { margin-top: clamp(2.5rem, 6vh, 4rem); }
 
-/* 13d · 08 · Contact, the page: the band itself, full height; the address, the copy control, LinkedIn and GitHub */
+/* 13d · 08 · Contact, the page: the band itself, one screen tall, composed like the cover (FIX2-PAGE, verdict ceiling:
+   no more half a screen of paper above the copy). The copy is in the flow, a grid of four rows: the eyebrow, the line,
+   a room of paper (1fr) and the foot. The line is set at the cover's name scale (fx-hero.css §1, --t-hero), capped by
+   the measure (--tw: its widest line in em, from the partial), stepped like TUVERI. The foot is the cover's too: the
+   sentence on the left, the address, its copy control, LinkedIn and GitHub on the right edge; on a phone they stack.
+   The stage's lens rests on the line, near its right end (fx-stage.js, the pool on .band-page): up to 260 px, so on
+   a phone the eyebrow stands well above the line and the sentence well below it, both out of the glass's reach; the
+   sentence and the address are the settling ink's keep-outs */
 .band-page { aspect-ratio: auto; min-height: 100svh; }
-.band-copy h1 { max-width: calc(var(--ch-d) * 18); }
+.band-page.pg-open { padding-top: 0; }
+.band-page .band-copy {
+  position: relative; left: auto; right: auto; bottom: auto;
+  display: grid; grid-template-columns: minmax(0, 1fr);
+  grid-template-rows: auto auto minmax(clamp(4.5rem, 10vh, 7rem), 1fr) auto;
+  min-height: 100svh;
+  padding: calc(var(--hdr) + clamp(1rem, 3vh, 2.5rem)) var(--pad) clamp(2rem, 5vh, 3.5rem);
+}
+.band-page .eyebrow { grid-row: 1; }
+.ct-h {
+  grid-row: 2; max-width: none; margin-top: clamp(1rem, 3vh, 2rem);
+  --t-ct: min(max(3.1rem, min(18vw, 25svh)), calc((100vw - 2 * var(--pad)) / var(--tw, 5)));
+  font-size: var(--t-ct); font-weight: var(--w-hero); line-height: 0.9; letter-spacing: var(--tr-hero);
+}
+/* the step: TUVERI's 0.95 em. The held last two words (the partial's no-break span, the line's only span) are the
+   second line, set as a block: the break never depends on the width or on SplitText's line count, and the split line
+   (one masked block) and the printed one look the same. A one-word line ("Scrivimi.") has no span and stays one line */
+.ct-h span { display: block; padding-left: 0.95em; }
+.ct-lead { grid-row: 4; max-width: 30ch; margin: 0; color: var(--graphite); }
+.ct-reach { grid-row: 5; margin-top: clamp(1.5rem, 4vh, 2.5rem); }
+.ct-reach .sc-email { margin-top: 0; }
 .band-else { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 1.5rem 0 0; padding: 0; list-style: none; font: 500 1rem/1.4 var(--f-text); text-transform: uppercase; letter-spacing: 0.08em; }
 .band-else a { color: var(--ink); text-decoration: none; }
 @media (pointer: coarse) { .band-else a { display: inline-block; padding-block: 0.75rem; } }
-@media (max-width: 767.98px) { .band-page { min-height: 100svh; } }
+@media (max-width: 1023.98px) {
+  .ct-h { --t-ct: min(max(3.1rem, min(19.5vw, 28svh)), calc((100vw - 2 * var(--pad)) / var(--tw, 5))); margin-top: clamp(4.5rem, 10svh, 6rem); }
+  .band-page .band-copy { grid-template-rows: auto auto minmax(4.5rem, 1fr) auto auto; }
+}
+@media (min-width: 1024px) {
+  .band-page .band-copy { grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--gut); }
+  .band-page .eyebrow, .ct-h { grid-column: 1 / -1; }
+  .ct-lead { grid-row: 4; grid-column: 1; align-self: end; }
+  .ct-reach { grid-row: 4; grid-column: 2; align-self: end; margin-top: 0; text-align: right; }
+  .ct-reach .band-else { justify-content: flex-end; }
+}
 
 @media print {
   .ix-dusk { --paper: #ffffff; --paper-deep: #ffffff; --ink: #24211e; --graphite: #48443e; --stone: #6b665d; --line: #dcd5c8; --accent: #2340c9; }
